  </div>

  <script>
    // GENERATE MASSIVE HISTORICAL GRAPH DATA
    const historyPath = document.createElementNS("http://www.w3.org/2000/svg", "path");
    historyPath.setAttribute("class", "stock-line");
    historyPath.setAttribute("id", "stockLineHistory");
    historyPath.style.stroke = "#ff3366";
    historyPath.style.filter = "drop-shadow(0 0 16px rgba(255,51,102,0.95))";

    let pathD = "M -400 600 ";
    let currentY = 600;
    for(let x = -400; x < 0; x += 10) {
      let trend = (160 - currentY) * 0.02;
      if (x > -350 && x < -100) trend -= 15; // aggressive jagged climb
      if (x > -100) trend = (160 - currentY) * 0.15; // pull to 160 at the end
      currentY += trend + (Math.sin(x * 0.73) * Math.cos(x * 0.29)) * 120; // deterministic volatility
      pathD += `L ${x} ${currentY.toFixed(1)} `;
    }
    pathD += "L 0 160"; // Connect perfectly to the start of the noise line
    historyPath.setAttribute("d", pathD);
    document.querySelector(".chart-svg").prepend(historyPath);

    window.__timelines = window.__timelines || {};

    // INITIAL FRAME 0 STATE (Baked from Scene 2's 17s mark)
    gsap.set("#stockLineHistory", { x: -19, y: 19, opacity: 1 });

    gsap.set(".chart-container", { x: 41, y: -755, data: "hf-hold" });

    // Camera Zoom Out state
    gsap.set("#chartStage", { scale: 0.45, x: 80, y: 140, opacity: 1 });

    // UI states
    gsap.set(".mac-3d-ground-layer, .crt-glass-glare, .crt-scanlines, .vhs-timestamp, .chart-header, .chart-grid, #chartFlash", { opacity: 0 });
    gsap.set("#mac3DStage", { scale: 2.5, rotateX: 0, x: -240, y: 550, opacity: 1 });
    gsap.set("#fixedHudHeader, #digitalVoidBg", { opacity: 1 });

    // Remove the cursor and minimal stage completely
    gsap.set("#minimalStage, #mouseCursor", { scaleX: 0, scaleY: 0, opacity: 0 });

    const tl = gsap.timeline({ paused: true });

    // Phase 1: Zoom in and center on the loss counter (0.5s - 3.0s)
    tl.to("#chartStage", { scale: 1.5, x: -350, y: 170, duration: 2.5, ease: "power3.inOut" }, 0.5);

    // Fade out graph elements
    tl.to("#stockLineHistory, #stockLineCrash, #stockLineNoise, #digitalVoidBg, #fixedHudHeader", { opacity: 0, duration: 2.0, ease: "power2.inOut" }, 0.5);

    // Phase 2: Currency Conversion (3.5s - 6.0s)
    tl.to("#lossLabel", { opacity: 0, duration: 0.3 }, 3.2);
    tl.add(() => { document.getElementById("lossLabel").innerText = "UNREALIZED LOSS (USD)"; }, 3.5);
    tl.to("#lossLabel", { opacity: 1, duration: 0.3 }, 3.5);

    const valObj = { yen: -40700000000 };
    tl.to(valObj, { 
      yen: -340000000, 
      duration: 2.5, 
      ease: "power2.inOut",
      onUpdate: function() {
        const progress = this.progress();
        let prefix = "-¥";
        if (progress > 0.1 && progress < 0.9) {
            const chars = ["¥", "€", "£", "¢", "§", "#", "@", "%", "&"];
            prefix = "-" + chars[Math.floor(progress * 100) % chars.length];
        } else if (progress >= 0.9) {
            prefix = "-$";
        }
        document.getElementById("lossValue").innerText = prefix + Math.floor(Math.abs(valObj.yen)).toLocaleString("en-US");
      }
    }, 3.5);

    // Glow pulse on completion
    tl.to(".loss-counter-wrapper", { filter: "brightness(1.5) drop-shadow(0 0 30px #ff3366)", scale: 1.05, duration: 0.2, yoyo: true, repeat: 1 }, 6.0);

    // Padding out to 10s
    tl.to({}, { duration: 4.0 }, 6.0);

    tl.set(".loss-counter-wrapper", { opacity: 1, immediateRender: true }, 0);

    tl.set(".loss-counter-wrapper", { x: -3, y: 705, immediateRender: true }, 0);

    window.__timelines["stock-order-aftermath"] = tl;
  </script>
