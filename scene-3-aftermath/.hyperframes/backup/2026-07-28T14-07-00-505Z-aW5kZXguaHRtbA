  <style>
    @font-face { font-family: 'Courier New'; src: local('Courier New'); }
    @font-face { font-family: 'Lucida Console'; src: local('Lucida Console'); }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { margin: 0; background: #000; color: #fff; font-family: 'Courier New', 'Lucida Console', monospace; overflow: hidden; -webkit-font-smoothing: antialiased; text-rendering: geometricPrecision; }
    #root { position: relative; width: 1920px; height: 1080px; overflow: hidden; user-select: none; transform: translateZ(0); }
    #bg { position: absolute; inset: 0; background: #000; display: flex; align-items: center; justify-content: center; perspective: 1400px; }
