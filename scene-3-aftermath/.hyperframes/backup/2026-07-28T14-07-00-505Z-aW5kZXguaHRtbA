    /* COUNTER FIELD CONTAINER BOX */
    .counter-box { position: relative; background: #080d14; border: 2.5px solid rgba(255, 255, 255, 0.2); border-radius: 12px; padding: 22px 32px; display: flex; align-items: center; justify-content: space-between; height: 150px; box-shadow: 0 20px 48px rgba(0,0,0,0.95); transform-style: preserve-3d; }
    .counter-label { font-family: 'Courier New', 'Lucida Console', monospace; font-size: 26px; font-weight: 700; color: #94a3b8; letter-spacing: 3px; text-transform: uppercase; text-shadow: 0 0 6px rgba(148,163,184,0.45); }
    
    /* VALUE WRAPPER - RED BLOOM POST-SWAP */
    .counter-value-wrapper { position: relative; display: flex; align-items: center; gap: 8px; }

    #valQty { font-family: 'Courier New', 'Lucida Console', monospace; font-size: 96px; font-weight: 700; color: #ff3366; letter-spacing: -1.5px; display: inline-block; opacity: 1; text-shadow: 0 0 20px rgba(255, 51, 102, 0.95), 0 0 40px rgba(255, 51, 102, 0.5); transform-origin: center center; }
    #valPrice { font-family: 'Courier New', 'Lucida Console', monospace; font-size: 96px; font-weight: 700; color: #ff3366; letter-spacing: -1.5px; display: inline-block; opacity: 1; text-shadow: 0 0 20px rgba(255, 51, 102, 0.95), 0 0 40px rgba(255, 51, 102, 0.5); transform-origin: center center; }
    .typing-caret-l { display: inline-block; width: 6px; height: 82px; background: #ffffff; opacity: 0; border-radius: 1px; box-shadow: 0 0 0 1.5px #000000, 0 0 10px #ffffff; }
    
    /* CONFIRM ORDER BUTTON */
    .confirm-container { position: relative; width: 680px; margin: 0 auto; }
    .retro-confirm-btn { width: 100%; height: 80px; background: linear-gradient(180deg, #32d74b 0%, #1db937 100%); border: 3.5px outset #ffffff; border-right-color: #0d5c1a; border-bottom-color: #0d5c1a; border-radius: 8px; color: #ffffff; font-family: 'Courier New', 'Lucida Console', monospace; font-size: 28px; font-weight: 700; letter-spacing: 3px; text-shadow: 2px 2px 2px #000000; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 12px; box-shadow: 0 12px 28px rgba(0,0,0,0.7), 0 0 16px rgba(50,215,75,0.45); transition: border-color 0.15s; }
    .retro-confirm-btn.clicked { border: 3.5px inset #0d5c1a; background: linear-gradient(180deg, #1db937 0%, #17a02e 100%); }
    #mouseCursor { position: absolute; top: 0; left: 0; width: 44px; height: 52px; z-index: 35; pointer-events: none; filter: drop-shadow(2px 3px 6px rgba(0,0,0,0.9)); }
    .click-ripple { position: absolute; width: 56px; height: 56px; border: 4px solid #00ff44; border-radius: 50%; z-index: 34; transform: translate(-50%, -50%) scale(0.2); opacity: 0; }
    
    /* CHART SCENE */
    .digital-void-bg { position: absolute; left: -20000px; top: -20000px; width: 40000px; height: 40000px; background: #000; z-index: 0; opacity: 0; pointer-events: none; }
    .fixed-hud-header { position: absolute; left: 80px; bottom: 80px; transform: scale(0.6); transform-origin: left bottom; font-size: 42px; font-weight: 700; color: #cbd5e1; letter-spacing: 6px; text-shadow: 0 0 12px rgba(203,213,225,0.6); opacity: 0; z-index: 9999; pointer-events: none; }
    .chart-stage { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 30px; opacity: 0; pointer-events: none; z-index: 20; }
    .chart-header { position: absolute; left: 80px; top: 40px; font-size: 42px; font-weight: 700; color: #cbd5e1; letter-spacing: 6px; text-shadow: 0 0 12px rgba(203,213,225,0.6); }
    .chart-container { position: absolute; left: 80px; top: 120px; width: 800px; height: 340px; }
    .chart-grid { position: absolute; left: -20000px; top: -20000px; width: 40000px; height: 40000px; background-image: linear-gradient(rgba(0,255,102,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(0,255,102,0.1) 1px, transparent 1px); background-size: 40px 40px; z-index: 1; }
    .chart-svg { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 10; overflow: visible; filter: url(#vertBlur); }
    .stock-line { fill: none; stroke: #00ff66; stroke-width: 4; stroke-linejoin: round; stroke-linecap: round; filter: drop-shadow(0 0 8px rgba(0,255,102,0.8)); }
    .loss-counter-wrapper { position: absolute; left: 590px; width: 300px; top: 40px; display: flex; flex-direction: column; align-items: flex-start; text-align: left; gap: 2px; z-index: 50; opacity: 0; }
    .loss-counter-label { font-family: 'Courier New', 'Lucida Console', monospace; font-size: 24px; font-weight: 700; color: #ff3366; letter-spacing: 2px; text-transform: uppercase; text-shadow: 0 0 6px rgba(255,51,102,0.7); }
    .loss-counter-value { font-size: 24px; font-weight: 700; color: #ff3366; text-shadow: 0 0 8px rgba(255,51,102,0.9), 0 0 16px rgba(255,51,102,0.5); font-variant-numeric: tabular-nums; letter-spacing: -1px; }
    .chart-red-flash { position: absolute; inset: 0; background: rgba(255,51,102,0.25); opacity: 0; z-index: 100; pointer-events: none; mix-blend-mode: screen; }
  </style>
</head>
<body>
  <svg data-hf-id="hf-qfii" width="0" height="0" style="position:absolute;"><defs data-hf-id="hf-mh0t"><filter data-hf-id="hf-deqi" id="vertBlur" x="-50%" y="-50%" width="200%" height="200%"><fegaussianblur data-hf-id="hf-hcpy" id="blurVal" stdDeviation="0 0" /></filter><lineargradient data-hf-id="hf-x8r2" id="silverGradient" x1="0%" y1="0%" x2="100%" y2="100%"><stop data-hf-id="hf-7b67" offset="0%" stop-color="#ffffff" /><stop data-hf-id="hf-oqaw" offset="25%" stop-color="#e2e8f0" /><stop data-hf-id="hf-5jtt" offset="48%" stop-color="#475569" /><stop data-hf-id="hf-v9c4" offset="68%" stop-color="#94a3b8" /><stop data-hf-id="hf-a2d3" offset="88%" stop-color="#e2e8f0" /><stop data-hf-id="hf-bwui" offset="100%" stop-color="#ffffff" /></lineargradient></defs></svg>
  <div data-hf-id="hf-goxw" id="root" data-composition-id="stock-order-aftermath" data-start="0" data-width="1920" data-height="1080" data-duration="10">
    <div data-hf-id="hf-2xc0" id="bg">
