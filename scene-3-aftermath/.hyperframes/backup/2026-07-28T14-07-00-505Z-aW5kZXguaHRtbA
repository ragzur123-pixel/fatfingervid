    .crt-glass-glare { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0.04) 28%, transparent 50%, rgba(255,255,255,0.02) 72%, rgba(255,255,255,0.08) 100%); z-index: 42; pointer-events: none; }
