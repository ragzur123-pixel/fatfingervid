                    <div data-hf-id="hf-82m1" class="chart-grid"></div>
                    <svg data-hf-id="hf-ndow" class="chart-svg" viewBox="0 0 800 340">
                      <!-- Upward trending, erratic chaotic noise -->
                      <path data-hf-id="hf-ntne" class="stock-line" id="stockLineNoise" d="M -20,180 L -5,140 L 10,190 L 30,50 L 45,120 L 55,100 L 70,220 L 85,190 L 100,240 L 120,60 L 135,110 L 150,90 L 165,150 L 180,180 L 200,30 L 215,80 L 230,70 L 245,130 L 260,250 L 280,210 L 295,240 L 310,160 L 325,180 L 345,100 L 360,60 L 375,190 L 390,140 L 410,20 L 425,70 L 440,50 L 455,140 L 470,110 L 490,40 L 505,80 L 520,30 L 535,50 L 550,20 L 560,40" stroke-dasharray="2360" stroke-dashoffset="0" style="stroke: #ff3366; filter: drop-shadow(0 0 16px rgba(255,51,102,0.95));" />
                      <!-- Vertical crash -->
                      <path data-hf-id="hf-gdqs" class="stock-line" id="stockLineCrash" d="M 560,40 L 575,400 L 590,800" stroke-dasharray="762" stroke-dashoffset="0" style="stroke: #ff3366; filter: drop-shadow(0 0 16px rgba(255,51,102,0.95));" />
