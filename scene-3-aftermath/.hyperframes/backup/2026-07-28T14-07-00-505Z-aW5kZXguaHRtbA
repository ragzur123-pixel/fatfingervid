        <div data-hf-id="hf-rgfm" class="mac-studio-wrapper">
          <div data-hf-id="hf-rkgo" class="mac-square-chassis">
            <div data-hf-id="hf-ap45" class="imac-handle"></div>
            <div data-hf-id="hf-920i" class="mac-crt-tube">
              <div data-hf-id="hf-bfjc" class="crt-glass-glare"></div>
              <div data-hf-id="hf-hh4q" class="crt-scanlines"></div>
              <section data-hf-id="hf-s2og" id="order-clip" class="clip" data-start="0" data-duration="10" data-track-index="1" data-media-start="0">
                <div data-hf-id="hf-h0ru" class="digital-void-bg" id="digitalVoidBg"></div>
                <div data-hf-id="hf-2x4z" class="minimal-stage" id="minimalStage">
                  <div data-hf-id="hf-2bh9" class="counters-group" id="countersGroup">
                    <div data-hf-id="hf-168v" class="counter-box" id="boxQty" style="border-color: #ff3366; background-color: #1f080e; box-shadow: 0 0 35px rgba(255,51,102,0.65), 0 20px 48px rgba(0,0,0,0.95);"><span data-hf-id="hf-3zkv" class="counter-label">QUANTITY</span><div data-hf-id="hf-89rs" class="counter-value-wrapper" id="wrapQty"><span data-hf-id="hf-vki5" id="valQty">610,000</span></div></div>
                    <div data-hf-id="hf-w3cc" class="counter-box" id="boxPrice" style="border-color: #ff3366; background-color: #1f080e; box-shadow: 0 0 35px rgba(255,51,102,0.65), 0 20px 48px rgba(0,0,0,0.95);"><span data-hf-id="hf-g3ko" class="counter-label">LIMIT PRICE</span><div data-hf-id="hf-zoz7" class="counter-value-wrapper" id="wrapPrice"><span data-hf-id="hf-6ymq" id="valPrice">1¥</span></div></div>
                  </div>
                  <div data-hf-id="hf-bzpd" class="confirm-container" id="confirmContainer"><button data-hf-id="hf-n823" class="retro-confirm-btn clicked" id="btnConfirm">✔ CONFIRM ORDER</button></div>
                </div>
                <div data-hf-id="hf-qj51" class="click-ripple" id="clickRipple"></div>
                <div data-hf-id="hf-8lu0" id="mouseCursor"><svg data-hf-id="hf-xlqh" width="44" height="52" viewBox="0 0 32 38" fill="none"><path data-hf-id="hf-uu4v" d="M0 0 L0 32 L8 24 L14 36 L19 33 L13 22 L23 22 Z" fill="#ffffff" stroke="#000000" stroke-width="2.2" stroke-linejoin="miter" /></svg></div>
