    .counter-box { position: relative; background: #080d14; border: 2.5px solid rgba(255, 255, 255, 0.2); border-radius: 12px; padding: 22px 32px; display: flex; align-items: center; justify-content: space-between; height: 150px; box-shadow: 0 20px 48px rgba(0,0,0,0.95); transform-style: preserve-3d; }
