  <script>
    window.__timelines = window.__timelines || {};
    const tl = gsap.timeline({ paused: true });

    tl.set(".chart-header", { x: -93, y: -23, data: "hf-hold" }, 0);

    // Set initial stationary state (same as end of previous timeline)
    gsap.set(".mac-3d-ground-layer", { opacity: 1 });
    gsap.set("#mac3DStage", { scale: 0.68, rotateX: 9, rotateY: 0, y: -35, opacity: 1 });
    gsap.set(".vhs-timestamp", { x: 0, y: 0, scale: 1, innerText: "REC ● DEC 08 2005 - 09:27:04 JST" });
    gsap.set("#mouseCursor", { x: 490, y: 520, opacity: 1 });

    // CRT TV TURN OFF EFFECT (0.5s - 1.0s)
    tl.to("#minimalStage, #mouseCursor", { scaleY: 0.005, filter: "brightness(3)", duration: 0.15, ease: "power4.in" }, 0.5);
    tl.to("#minimalStage, #mouseCursor", { scaleX: 0, opacity: 0, duration: 0.2, ease: "power4.in" }, 0.65);

    // FADE IN CHART SCENE (1.5s)
    tl.to("#chartStage", { opacity: 1, duration: 0.8, ease: "power2.out" }, 1.5);

    // ZOOM INTO MONITOR / CENTER THE TIP (1.5s - 4.5s)
    tl.to("#mac3DStage", { scale: 2.5, rotateX: 0, x: -240, y: 550, duration: 3.0, ease: "power2.inOut" }, 1.5);
    tl.to(".mac-3d-ground-layer, .crt-glass-glare, .crt-scanlines, .vhs-timestamp", { opacity: 0, duration: 1.5, ease: "power2.in" }, 1.5);

    // ANIMATE 3D HEADER TO EXACT SCREEN COORDINATES
    tl.to(".chart-header", { x: -200, y: -50, scale: 0.24, duration: 3.0, ease: "power2.inOut" }, 1.5);

    // DRAW JAGGED CHART LINE (1.5s - 4.5s)
    tl.to("#stockLineNoise", { strokeDashoffset: 0, duration: 3.0, ease: "none" }, 1.5);

    // THE CRASH (4.5s)
    tl.to("#stockLineNoise, #stockLineCrash", { stroke: "#ff3366", filter: "drop-shadow(0 0 16px rgba(255,51,102,0.95))", duration: 0.1 }, 4.5);
    tl.to("#stockLineCrash", { strokeDashoffset: 0, duration: 0.9, ease: "power4.in" }, 4.5);

    // PAN CAMERA DOWN WITH CRASH (4.5s - 5.4s)
    tl.to(".chart-container", { y: -760, duration: 0.9, ease: "power4.in" }, 4.5);

    // LOSS COUNTER TRACKS THE DROPPING LINE (4.5s - 5.4s)
    tl.to(".loss-counter-wrapper", { opacity: 1, duration: 0.1 }, 4.5);
    tl.to(".loss-counter-wrapper", { x: 30, y: 760, duration: 0.9, ease: "power4.in" }, 4.5);

    // SEAMLESS HUD SWAP (4.5s)
    tl.set(".chart-header", { opacity: 0 }, 4.5);
    tl.set("#fixedHudHeader", { opacity: 1 }, 4.5);

    // SCREEN FLASHES RED (4.5s)
    tl.to("#chartFlash", { opacity: 1, duration: 0.1 }, 4.5);
    tl.to("#chartFlash", { opacity: 0, duration: 0.8, ease: "power2.out" }, 4.6);

    const lossObj = { val: 0 };
    tl.to(lossObj, {
      val: 40700000000,
      duration: 6.5,
      ease: "power2.inOut",
      onUpdate: function() {
        document.getElementById("lossValue").innerText = "-¥" + Math.floor(lossObj.val).toLocaleString("en-US");
      }
    }, 4.5);

    // MASSIVE ZOOM OUT TO REVEAL FULL DROP (11.0s - 14.0s)
    tl.to("#chartStage", { scale: 0.35, duration: 3.0, ease: "power3.inOut" }, 11.0);
