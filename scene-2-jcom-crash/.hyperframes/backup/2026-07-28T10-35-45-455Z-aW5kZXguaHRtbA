    #mouseCursor { position: absolute; top: 0; left: 0; width: 44px; height: 52px; z-index: 35; pointer-events: none; filter: drop-shadow(2px 3px 6px rgba(0,0,0,0.9)); }
    .click-ripple { position: absolute; width: 56px; height: 56px; border: 4px solid #00ff44; border-radius: 50%; z-index: 34; transform: translate(-50%, -50%) scale(0.2); opacity: 0; }
    
    /* CHART SCENE */
    .fixed-hud-header { position: absolute; left: 220px; top: 965px; transform: translate(-50%, -50%) scale(0.6); transform-origin: center; font-size: 42px; font-weight: 700; color: #cbd5e1; letter-spacing: 6px; text-shadow: 0 0 12px rgba(203,213,225,0.6); opacity: 0; z-index: 9999; pointer-events: none; }
    .chart-stage { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 30px; opacity: 0; pointer-events: none; z-index: 20; }
    .chart-header { font-size: 42px; font-weight: 700; color: #cbd5e1; letter-spacing: 6px; text-shadow: 0 0 12px rgba(203,213,225,0.6); }
    .chart-container { position: absolute; left: 80px; top: 120px; width: 800px; height: 340px; }
    .chart-grid { position: absolute; left: -5000px; top: -5000px; width: 10000px; height: 10000px; background-image: linear-gradient(rgba(0,255,102,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(0,255,102,0.1) 1px, transparent 1px); background-size: 40px 40px; z-index: 1; }
    .chart-svg { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 10; overflow: visible; }
    .stock-line { fill: none; stroke: #00ff66; stroke-width: 4; stroke-linejoin: round; stroke-linecap: round; filter: drop-shadow(0 0 8px rgba(0,255,102,0.8)); }
    .loss-counter-wrapper { position: absolute; left: 300px; width: 240px; top: 40px; display: flex; flex-direction: column; align-items: flex-end; text-align: right; gap: 2px; z-index: 50; opacity: 0; }
    .loss-counter-label { font-size: 14px; color: #ff3366; letter-spacing: 2px; text-transform: uppercase; text-shadow: 0 0 6px rgba(255,51,102,0.7); }
    .loss-counter-value { font-size: 24px; font-weight: 700; color: #ff3366; text-shadow: 0 0 8px rgba(255,51,102,0.9), 0 0 16px rgba(255,51,102,0.5); font-variant-numeric: tabular-nums; letter-spacing: -1px; }
    .chart-red-flash { position: absolute; inset: 0; background: rgba(255,51,102,0.25); opacity: 0; z-index: 100; pointer-events: none; mix-blend-mode: screen; }
  </style>
</head>
