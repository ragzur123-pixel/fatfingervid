  <!-- GSAP Animation Master Timeline (15s Total Duration) -->
  <script>
    window.__timelines = window.__timelines || {};

    const tl = gsap.timeline({ paused: true });

    // DOM References
    const mac3DStage = "#mac3DStage";
    const boxQty = "#boxQty";
    const boxPrice = "#boxPrice";
    const valQty = document.getElementById("valQty");
    const valPrice = document.getElementById("valPrice");
    const caretQty = "#caretQty";
    const caretPrice = "#caretPrice";
    const mouseCursor = "#mouseCursor";
    const clickRipple = "#clickRipple";
    const btnConfirm = document.getElementById("btnConfirm");

    // INITIAL SETUP: ALL-WHITE MOUSE POINTER SPAWNS INSIDE CRT SCREEN TUBE AT RELATIVE (620, 280) UNDER CRT SCANLINES/GLARE
    gsap.set(mac3DStage, { scale: 0.85, rotateX: 8, rotateY: 0, opacity: 1 });
    gsap.set([caretQty, caretPrice], { opacity: 0 });
    gsap.set(mouseCursor, { x: 620, y: 280, opacity: 0 });
    gsap.set(clickRipple, { opacity: 0 });

    function triggerClick(x, y, color = "#00ff44") {
      gsap.set(clickRipple, { x, y, borderColor: color, opacity: 1, scale: 0.2 });
      gsap.to(clickRipple, { scale: 1.4, opacity: 0, duration: 0.35, ease: "power2.out" });
    }

    // 1. Entrance (0.0s - 1.0s) - Mouse Pointer Fades In INSIDE CRT Screen Tube under Scanlines & Glare
    tl.to(mouseCursor, { opacity: 1, duration: 0.4 }, 0.4);

    // 2. Typing Sequence BEFORE SPIN (1.0s - 4.0s)
    // Move mouse cursor inside screen tube to Quantity Box ~ (680, 180)
    tl.to(mouseCursor, { x: 680, y: 180, duration: 0.7, ease: "power2.inOut" }, 0.8);
    tl.add(() => triggerClick(680, 180), 1.5);

    tl.to(boxQty, { className: "counter-box active", duration: 0.1 }, 1.5);
    tl.to(caretQty, { opacity: 1, duration: 0.1 }, 1.5);

    // Typing 1 in Quantity (RED TEXT #ff3366)
    const qtyText = ["", "1"];
    qtyText.forEach((txt, i) => {
      tl.add(() => { valQty.textContent = txt; }, 1.6 + (i * 0.2));
    });

    // Move mouse cursor inside screen tube to Price Box ~ (680, 360)
    tl.to(boxQty, { className: "counter-box", duration: 0.15 }, 2.3);
    tl.to(caretQty, { opacity: 0, duration: 0.1 }, 2.3);

    tl.to(mouseCursor, { x: 680, y: 360, duration: 0.6, ease: "power2.inOut" }, 2.3);
    tl.add(() => triggerClick(680, 360), 2.9);

    tl.to(boxPrice, { className: "counter-box active", duration: 0.1 }, 2.9);
    tl.to(caretPrice, { opacity: 1, duration: 0.1 }, 2.9);

    // Typing ¥610,000 in Price (GREEN TEXT #00e676)
    const priceText = ["", "¥", "¥6", "¥61", "¥610", "¥610,", "¥610,0", "¥610,00", "¥610,000"];
    priceText.forEach((txt, i) => {
      tl.add(() => { valPrice.textContent = txt; }, 3.0 + (i * 0.1));
    });

    // 3. CAMERA ZOOMS STRAIGHT INTO THE MACINTOSH CRT SCREEN (4.0s - 8.0s)
    tl.to(boxPrice, { className: "counter-box", duration: 0.15 }, 4.0);
    tl.to(caretPrice, { opacity: 0, duration: 0.1 }, 4.0);

    // CAMERA ZOOMS STRAIGHT IN (0.85x -> 1.25x Scale, rotateX: 3deg, rotateY: 0deg)
    tl.to(mac3DStage, { 
      scale: 1.25, 
      rotateX: 3, 
      rotateY: 0, 
      y: -25, 
      duration: 0.9, 
      ease: "power2.inOut" 
    }, 4.0);

    // Deep suspense cursor drift inside zoomed CRT screen (4.0s - 8.0s)
    tl.to(mouseCursor, { x: 560, y: 340, duration: 1.2, ease: "power2.out" }, 4.2);
    tl.to(mouseCursor, { x: 520, y: 320, duration: 1.2, ease: "sine.inOut" }, 5.4);
    tl.to(mouseCursor, { x: 540, y: 335, duration: 1.2, ease: "sine.inOut" }, 6.6);

    // 4. SLOWER 4-SECOND 3D REEL FLIP SWAP WITH RECOIL (8.0s - 12.0s)
    // Phase 1: 3D Flip Out (Reel Spin Top to Bottom) (8.0s - 9.8s)
    tl.to([boxQty, boxPrice], { rotationX: -90, opacity: 0.3, duration: 1.8, ease: "power2.in" }, 8.0);

    // Commit Swapped Values (Quantity becomes 610,000 in RED #ff3366, Price becomes ¥1 in GREEN #00e676)
    tl.add(() => {
      valQty.textContent = "610,000";
      valPrice.textContent = "¥1";
    }, 9.8);

    // Phase 2: 3D Flip In with Mechanical Recoil (9.8s - 12.0s)
    tl.to([boxQty, boxPrice], { rotationX: 0, opacity: 1, duration: 2.2, ease: "back.out(2.0)" }, 9.8);

    // 5. CAMERA ZOOMS BACK OUT TO 8° TILT & MOUSE CURSOR LANDS DIRECTLY ON CONFIRM BUTTON CENTER (12.0s - 15.0s)
    tl.to(mac3DStage, { 
      scale: 0.85, 
      rotateX: 8, 
      rotateY: 0, 
      y: 0, 
      duration: 0.8, 
      ease: "power2.inOut" 
    }, 12.0);

    // TARGET CONFIRM BUTTON CENTER EXACTLY INSIDE CRT SCREEN TUBE AT RELATIVE (490, 520)
    tl.to(mouseCursor, { x: 490, y: 520, duration: 0.9, ease: "power2.inOut" }, 12.1);
    tl.add(() => triggerClick(490, 520, "#00ff44"), 13.0);

    // Tactile 3D Inset Button Push
    tl.to(btnConfirm, { className: "retro-confirm-btn clicked", duration: 0.12, yoyo: true, repeat: 1 }, 13.0);

    // Hold frame until 15.0s
    tl.to({}, { duration: 2.0 }, 13.0);

    // Register Master Timeline
    window.__timelines["stock-order-swap"] = tl;
  </script>
