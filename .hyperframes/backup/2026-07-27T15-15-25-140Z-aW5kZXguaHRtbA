  <svg data-hf-id="hf-qfii" width="0" height="0" style="position:absolute;">
    <defs data-hf-id="hf-mh0t">
      <lineargradient data-hf-id="hf-x8r2" id="silverGradient" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop data-hf-id="hf-7b67" offset="0%" stop-color="#ffffff" />
        <stop data-hf-id="hf-oqaw" offset="25%" stop-color="#e2e8f0" />
        <stop data-hf-id="hf-5jtt" offset="48%" stop-color="#475569" />
        <stop data-hf-id="hf-v9c4" offset="68%" stop-color="#94a3b8" />
        <stop data-hf-id="hf-a2d3" offset="88%" stop-color="#e2e8f0" />
        <stop data-hf-id="hf-bwui" offset="100%" stop-color="#ffffff" />
      </lineargradient>
    </defs>
  </svg>

  <!-- HyperFrames Standalone Composition Root (15-Second Duration) -->
  <div data-hf-id="hf-goxw" id="root" data-composition-id="stock-order-swap" data-start="0" data-width="1920" data-height="1080" data-duration="15">
    <!-- Background Frame with Independent 3D Ground & 8° Tilt Camera Stage -->
    <div data-hf-id="hf-2xc0" id="bg">
      
      <!-- INFINITE 3D GROUND PLANE LAYER WITH RADIAL MASK FADE -->
      <div data-hf-id="hf-3mm5" class="mac-3d-ground-layer">
        <div data-hf-id="hf-k7ik" class="mac-ground-shadow"></div>
      </div>

      <div data-hf-id="hf-hewe" class="mac-3d-stage" id="mac3DStage">
        <div data-hf-id="hf-rgfm" class="mac-studio-wrapper">
          
          <!-- Square Macintosh Computer Chassis -->
          <div data-hf-id="hf-rkgo" class="mac-square-chassis">
            <div data-hf-id="hf-ap45" class="imac-handle"></div>

            <!-- Heavy Curved Apple CRT Glass Tube Screen Container (64px Curvature) -->
            <div data-hf-id="hf-0jnq" class="mac-crt-tube">

              <!-- CRT Glass Glare & Scanlines OVERLAY EVERYTHING IN SCREEN -->
              <div data-hf-id="hf-bfjc" class="crt-glass-glare"></div>
              <div data-hf-id="hf-hh4q" class="crt-scanlines"></div>

              <!-- VHS 2005 Timestamp (High Visibility Z-Index) -->
              <div data-hf-id="hf-rzm6" class="vhs-timestamp">REC ● DEC 08 2005 - 09:27:04 JST</div>

              <!-- Main Stage Clip -->
              <section data-hf-id="hf-s2og" id="order-clip" class="clip" data-start="0" data-duration="15" data-track-index="1">
                
                <div data-hf-id="hf-2x4z" class="minimal-stage" id="minimalStage">
                  
                  <!-- Counters Group -->
                  <div data-hf-id="hf-2bh9" class="counters-group" id="countersGroup">
                    
                    <!-- Quantity Counter Box (Red Text: 1 -> 610,000) -->
                    <div data-hf-id="hf-168v" class="counter-box" id="boxQty">
                      <span data-hf-id="hf-3zkv" class="counter-label">QUANTITY</span>
                      <div data-hf-id="hf-08oa" class="counter-value-wrapper">
                        <span data-hf-id="hf-vki5" id="valQty"></span>
                        <span data-hf-id="hf-5886" class="mac-ibeam-caret" id="caretQty"></span>
                      </div>
                    </div>

                    <!-- Price Counter Box (Green Text: ¥610,000 -> ¥1) -->
                    <div data-hf-id="hf-w3cc" class="counter-box" id="boxPrice">
                      <span data-hf-id="hf-g3ko" class="counter-label">LIMIT PRICE</span>
                      <div data-hf-id="hf-k0by" class="counter-value-wrapper">
                        <span data-hf-id="hf-6ymq" id="valPrice"></span>
                        <span style="text-align: center" data-hf-id="hf-76b5" class="mac-ibeam-caret" id="caretPrice"></span>
                      </div>
                    </div>

                  </div>

                  <!-- Centered Retro Confirm Button -->
                  <div data-hf-id="hf-bzpd" class="confirm-container" id="confirmContainer">
                    <button data-hf-id="hf-n823" class="retro-confirm-btn" id="btnConfirm">
                      ✔ CONFIRM ORDER
                    </button>
                  </div>

                </div>

                <!-- CLICK RIPPLE & ALL-WHITE MOUSE CURSOR UNDER CRT SCANLINES/GLARE (Z-INDEX 35) -->
                <div data-hf-id="hf-qj51" class="click-ripple" id="clickRipple"></div>

                <div data-hf-id="hf-8lu0" id="mouseCursor">
                  <svg data-hf-id="hf-xlqh" width="44" height="52" viewBox="0 0 32 38" fill="none">
                    <path data-hf-id="hf-qxsj" d="M0 0 L0 32 L8 24 L14 36 L19 33 L13 22 L23 22 Z" fill="#ffffff" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="miter" />
                  </svg>
