<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1920, height=1080">
  <title>15s Pure White All-CRT Overlay Macintosh Swap Visual - HyperFrames</title>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
  <style>
    @font-face {
      font-family: 'Courier New';
      src: local('Courier New');
    }
    @font-face {
      font-family: 'Lucida Console';
      src: local('Lucida Console');
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      margin: 0;
      background: #000000;
      color: #ffffff;
      font-family: 'Courier New', 'Lucida Console', monospace;
      overflow: hidden;
      -webkit-font-smoothing: none;
    }

    /* HyperFrames Standalone Composition Root (15-Second Duration) */
    #root {
      position: relative;
      width: 1920px;
      height: 1080px;
      overflow: hidden;
      user-select: none;
    }

    /* Pure Pitch-Black Background (Full Bleed Child) */
    #bg {
      position: absolute;
      inset: 0;
      background: #000000;
      display: flex;
      align-items: center;
      justify-content: center;
      perspective: 1400px;
    }

    /* INFINITE 3D GROUND PLANE LAYER WITH RADIAL MASK FADE */
    .mac-3d-ground-layer {
      position: absolute;
      width: 3200px;
      height: 2000px;
      bottom: -320px;
      background: radial-gradient(
        ellipse at 50% 35%, 
        #1e293b 0%, 
        #0f172a 38%, 
        #020617 65%, 
        #000000 90%
      );
      transform: rotateX(76deg);
      transform-origin: bottom center;
      -webkit-mask-image: radial-gradient(ellipse at 50% 40%, rgba(0, 0, 0, 1) 30%, rgba(0, 0, 0, 0.7) 55%, transparent 80%);
      mask-image: radial-gradient(ellipse at 50% 40%, rgba(0, 0, 0, 1) 30%, rgba(0, 0, 0, 0.7) 55%, transparent 80%);
      z-index: 1;
      pointer-events: none;
    }

    /* Soft Radial Ambient Ground Shadow Falloff */
    .mac-ground-shadow {
      position: absolute;
      top: 35%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 1400px;
      height: 700px;
      background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.99) 0%, rgba(0, 0, 0, 0.75) 45%, transparent 80%);
      pointer-events: none;
    }

    /* 3D Perspective Stage Container (8° Tilt Camera Rig) */
    .mac-3d-stage {
      position: relative;
      width: 1920px;
      height: 1080px;
      display: flex;
      align-items: center;
      justify-content: center;
      transform-style: preserve-3d;
      transform-origin: center center;
      z-index: 10;
    }

    /* 3D MACINTOSH COMPUTER SETUP ATOP 3D GROUND */
    .mac-studio-wrapper {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      transform-style: preserve-3d;
      z-index: 10;
    }

    /* HIGH-DEFINITION SQUARE ALL-IN-ONE MACINTOSH COMPUTER CHASSIS */
    .mac-square-chassis {
      position: relative;
      width: 1160px;
      height: 980px;
      background: linear-gradient(180deg, #007a87 0%, #005a66 48%, #e2e8f0 76%, #cbd5e1 100%);
      border: 14px solid rgba(255, 255, 255, 0.45);
      border-radius: 56px 56px 24px 24px;
      box-shadow: 
        0 40px 100px rgba(0, 0, 0, 0.95),
        inset 0 6px 18px rgba(255, 255, 255, 0.8),
        inset 0 -14px 32px rgba(0, 0, 0, 0.55);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 24px 32px 18px;
      overflow: hidden;
      transform-style: preserve-3d;
      z-index: 10;
    }

    /* PHYSICAL 3D MACINTOSH BASE STAND FOOT RESTING ON GROUND */
    .mac-base-foot {
      position: relative;
      width: 960px;
      height: 36px;
      background: linear-gradient(180deg, #94a3b8 0%, #475569 50%, #1e293b 100%);
      border: 2px solid #cbd5e1;
      border-radius: 0 0 20px 20px;
      box-shadow: 
        0 12px 24px rgba(0, 0, 0, 0.9),
        inset 0 2px 4px rgba(255, 255, 255, 0.6);
      margin-top: -4px;
      z-index: 12;
    }

    /* HIGH-DENSITY AMBIENT OCCLUSION COLLISION LINE */
    .mac-ao-line {
      position: relative;
      width: 1020px;
      height: 14px;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0) 100%);
      margin-top: -6px;
      filter: blur(2px);
      z-index: 13;
    }

    /* Top Translucent Handle */
    .imac-handle {
      position: absolute;
      top: 10px;
      width: 220px;
      height: 20px;
      background: rgba(255, 255, 255, 0.35);
      border-radius: 10px;
      border: 2px solid rgba(255, 255, 255, 0.65);
    }

    /* HEAVY CURVED CRT SCREEN TUBE (64PX CORNER CURVATURE) */
    .mac-crt-tube {
      position: relative;
      width: 100%;
      height: 760px;
      background: #000000;
      border: 32px solid #0f172a;
      border-radius: 64px;
      box-shadow: 
        inset 0 0 75px rgba(0, 0, 0, 0.95),
        0 0 35px rgba(0, 0, 0, 0.9);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* EXPANDED BOTTOM CHIN (110PX HEIGHT) */
    .mac-expanded-chin {
      position: relative;
      width: 100%;
      height: 110px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 12px;
    }

    /* OFFICIAL 68PX SILVER METALLIC APPLE BADGE */
    .mac-centered-apple-badge {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .official-silver-apple-icon {
      width: 60px;
      height: 72px;
      fill: url(#silverGradient);
      filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.65));
    }

    /* Curved CRT Glass Glare Overlay - TOP Z-INDEX OVER EVERYTHING IN SCREEN */
    .crt-glass-glare {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        135deg, 
        rgba(255, 255, 255, 0.12) 0%, 
        rgba(255, 255, 255, 0.03) 30%, 
        transparent 55%, 
        rgba(0, 176, 255, 0.03) 75%, 
        rgba(255, 255, 255, 0.05) 100%
      );
      z-index: 42;
      pointer-events: none;
    }

    /* CRT Scanlines Overlay - OVERALL SCANLINES EFFECT OVER CURSOR & CONTENT */
    .crt-scanlines {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        rgba(18, 16, 16, 0) 50%, 
        rgba(0, 0, 0, 0.45) 50%
      );
      background-size: 100% 4px;
      z-index: 40;
      opacity: 0.6;
      pointer-events: none;
    }

    /* VHS 2005 Timestamp Overlay - HIGH VISIBILITY Z-INDEX */
    .vhs-timestamp {
      position: absolute;
      bottom: 28px;
      left: 36px;
      font-family: 'Courier New', 'Lucida Console', monospace;
      font-size: 24px;
      font-weight: 700;
      color: #00ff66;
      text-shadow: 0 0 10px rgba(0, 255, 102, 0.7), 2px 2px #000000;
      z-index: 60;
      letter-spacing: 2px;
      pointer-events: none;
    }

    /* Main Scene Clip Container */
    .clip {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
    }

    /* Minimalist High-Contrast Order Stage */
    .minimal-stage {
      position: relative;
      width: 980px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 32px;
      transform-origin: center center;
    }

    /* Oversized Retro Counter Box Group */
    .counters-group {
      position: relative;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 24px;
      perspective: 1200px;
    }

    /* Individual Giant Counter Field Box */
    .counter-box {
      position: relative;
      background: #080d14;
      border: 3.5px inset #7f9db9;
      border-radius: 10px;
      padding: 22px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 150px;
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.95);
      transform-style: preserve-3d;
      backface-visibility: hidden;
      transition: border-color 0.3s, background-color 0.3s;
    }

    .counter-box.active {
      border-color: #316ac5;
      background: #0d1726;
      box-shadow: 0 0 0 3.5px #316ac5;
    }

    /* ULTRA-GIANT 26PX LABELS IN RETRO MONOSPACE */
    .counter-label {
      font-family: 'Courier New', 'Lucida Console', monospace;
      font-size: 26px;
      font-weight: 700;
      color: #94a3b8;
      letter-spacing: 3px;
      text-transform: uppercase;
      text-shadow: 0 0 12px rgba(148, 163, 184, 0.5);
    }

    .counter-value-wrapper {
      position: relative;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* QUANTITY TEXT IS ALWAYS RED (#ff3366) WITH HIGH-DEF PHOSPHOR GLOW */
    #valQty {
      font-family: 'Courier New', 'Lucida Console', monospace;
      font-size: 96px;
      font-weight: 700;
      color: #ff3366;
      letter-spacing: -1.5px;
      display: inline-block;
      text-shadow: 
        0 0 16px rgba(255, 51, 102, 0.8),
        0 0 32px rgba(255, 51, 102, 0.4);
    }

    /* PRICE TEXT IS ALWAYS GREEN (#00e676) WITH HIGH-DEF PHOSPHOR GLOW */
    #valPrice {
      font-family: 'Courier New', 'Lucida Console', monospace;
      font-size: 96px;
      font-weight: 700;
      color: #00e676;
      letter-spacing: -1.5px;
      display: inline-block;
      text-shadow: 
        0 0 16px rgba(0, 230, 118, 0.8),
        0 0 32px rgba(0, 230, 118, 0.4);
    }

    /* ALL-WHITE CLASSIC MAC OS SERIF I-BEAM TYPING CARET UNDER CRT OVERLAY */
    .mac-ibeam-caret {
      display: inline-block;
      width: 10px;
      height: 76px;
      border-top: 4px solid #ffffff;
      border-bottom: 4px solid #ffffff;
      border-left: 3.5px solid #ffffff;
      opacity: 0;
      box-shadow: 0 0 18px #ffffff, 0 0 30px rgba(255, 255, 255, 0.8);
    }

    /* Centered Bold Retro Confirm Button */
    .confirm-container {
      position: relative;
      width: 100%;
    }

    .retro-confirm-btn {
      width: 100%;
      height: 80px;
      background: linear-gradient(180deg, #32d74b 0%, #1db937 100%);
      border: 3.5px outset #ffffff;
      border-right-color: #0d5c1a;
      border-bottom-color: #0d5c1a;
      border-radius: 8px;
      color: #ffffff;
      font-family: 'Courier New', 'Lucida Console', monospace;
      font-size: 28px;
      font-weight: 700;
      letter-spacing: 3px;
      text-shadow: 2px 2px 2px #000000;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      transition: border-color 0.15s;
    }

    .retro-confirm-btn.clicked {
      border: 3.5px inset #0d5c1a;
      background: linear-gradient(180deg, #1db937 0%, #17a02e 100%);
    }

    /* ALL-WHITE SYSTEM 7 MOUSE POINTER UNDER CRT SCANLINES & GLARE OVERLAY (Z-INDEX 35) */
    #mouseCursor {
      position: absolute;
      top: 0;
      left: 0;
      width: 44px;
      height: 52px;
      z-index: 35;
      pointer-events: none;
      filter: drop-shadow(0 0 12px rgba(255, 255, 255, 0.9));
    }

    .click-ripple {
      position: absolute;
      width: 56px;
      height: 56px;
      border: 4px solid #00ff44;
      border-radius: 50%;
      z-index: 34;
      transform: translate(-50%, -50%) scale(0.2);
      opacity: 0;
    }
  </style>
</head>
<body>
