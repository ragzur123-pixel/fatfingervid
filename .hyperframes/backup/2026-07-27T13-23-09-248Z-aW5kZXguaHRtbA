<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1920, height=1080">
  <title>Dramatic Minimalist 2005 Swap Visual - HyperFrames</title>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
  <style>
    @font-face {
      font-family: 'MS Sans Serif';
      src: local('MS Sans Serif');
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      margin: 0;
      background: #000000;
      color: #ffffff;
      font-family: Tahoma, 'MS Sans Serif', sans-serif;
      overflow: hidden;
      -webkit-font-smoothing: none;
    }

    /* HyperFrames Root Composition Container */
    #root {
      position: relative;
      width: 1920px;
      height: 1080px;
      overflow: hidden;
      user-select: none;
    }

    /* Pure Pitch-Black Background (Full Bleed Child) */
    #bg {
      position: absolute;
      inset: 0;
      background: #000000;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Subtle CRT Scanlines Overlay */
    .crt-scanlines {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        rgba(18, 16, 16, 0) 50%, 
        rgba(0, 0, 0, 0.4) 50%
      );
      background-size: 100% 4px;
      z-index: 40;
      opacity: 0.6;
      pointer-events: none;
    }

    /* VHS Timestamp */
    .vhs-timestamp {
      position: absolute;
      bottom: 28px;
      left: 40px;
      font-family: 'Courier New', monospace;
      font-size: 24px;
      font-weight: 700;
      color: #00ff66;
      text-shadow: 2px 2px #000000;
      z-index: 45;
      letter-spacing: 2px;
    }

    /* Glitch RGB Offset Layers */
    .crt-glitch-layer {
      position: absolute;
      inset: 0;
      z-index: 39;
      opacity: 0;
      mix-blend-mode: screen;
      pointer-events: none;
    }
    .crt-glitch-layer.red {
      background: rgba(255, 0, 0, 0.3);
      transform: translate(-6px, 3px);
    }
    .crt-glitch-layer.cyan {
      background: rgba(0, 255, 255, 0.3);
      transform: translate(6px, -3px);
    }

    /* Main Scene Clip Container */
    .clip {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
    }

    /* Minimalist High-Contrast Order Stage */
    .minimal-stage {
      position: relative;
      width: 900px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 32px;
      transform-origin: center center;
    }

    /* Oversized Retro Counter Box Group */
    .counters-group {
      position: relative;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    /* Individual Giant Counter Field Box */
    .counter-box {
      position: relative;
      background: #080d14;
      border: 3px inset #7f9db9;
      border-radius: 8px;
      padding: 20px 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 120px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.9);
    }

    .counter-box.active {
      border-color: #316ac5;
      background: #0d1726;
      box-shadow: 0 0 0 2px #316ac5;
    }

    .counter-box.swapped {
      background: #2a0008;
      border: 3px solid #ff0033;
      box-shadow: 0 0 0 3px #ff0033;
    }

    .counter-label {
      font-size: 16px;
      font-weight: 800;
      color: #94a3b8;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .counter-value-wrapper {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* GIANT 64PX NUMBERS */
    .counter-value {
      font-family: 'Courier New', monospace;
      font-size: 64px;
      font-weight: 900;
      color: #ffffff;
      letter-spacing: -1px;
    }

    .xp-caret {
      display: inline-block;
      width: 4px;
      height: 56px;
      background: #ffffff;
      opacity: 0;
    }

    /* Giant Swap Button Row */
    .swap-btn-row {
      position: absolute;
      right: 28px;
      top: 50%;
      transform: translateY(-50%);
      z-index: 15;
    }

    .retro-swap-btn {
      background: #ece9d8;
      border: 3px outset #ffffff;
      border-right-color: #404040;
      border-bottom-color: #404040;
      padding: 8px 20px;
      font-size: 14px;
      font-weight: 800;
      color: #003399;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 2px 2px 0 #000000;
    }

    /* Centered Bold Retro Confirm Button */
    .confirm-container {
      position: relative;
      width: 100%;
    }

    .retro-confirm-btn {
      width: 100%;
      height: 72px;
      background: linear-gradient(180deg, #32d74b 0%, #1db937 100%);
      border: 3px outset #ffffff;
      border-right-color: #0d5c1a;
      border-bottom-color: #0d5c1a;
      border-radius: 6px;
      color: #ffffff;
      font-size: 24px;
      font-weight: 900;
      letter-spacing: 2px;
      text-shadow: 2px 2px 2px #000000;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }

    /* Flashing Solid Outline (No modern blur glow) */
    .btn-outline-flash {
      position: absolute;
      inset: -6px;
      border: 3px solid #ffff00;
      background: rgba(255, 255, 0, 0.2);
      border-radius: 8px;
      opacity: 0;
    }

    /* Authentic 2005 Windows XP Error Dialog Box */
    .xp-modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      z-index: 50;
      opacity: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .xp-dialog-box {
      width: 520px;
      background: #ece9d8;
      border: 3px solid #0055ea;
      border-radius: 8px 8px 0 0;
      box-shadow: 6px 10px 30px rgba(0, 0, 0, 0.9);
      transform: scale(0.9);
      opacity: 0;
    }

    .xp-dialog-header {
      height: 34px;
      background: linear-gradient(180deg, #0058ee 0%, #0055ea 100%);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 10px;
      color: white;
      font-weight: 800;
      font-size: 13px;
    }

    .xp-dialog-body {
      padding: 24px 28px;
      display: flex;
      gap: 20px;
      align-items: flex-start;
    }

    .xp-error-icon {
      width: 44px;
      height: 44px;
      background: #cc0000;
      border-radius: 50%;
      color: white;
      font-weight: 900;
      font-size: 28px;
      display: grid;
      place-items: center;
      border: 2px solid #ffffff;
      box-shadow: 2px 2px 6px rgba(0,0,0,0.5);
      flex-shrink: 0;
    }

    .xp-dialog-text h3 {
      font-size: 16px;
      font-weight: 800;
      color: #000000;
      margin-bottom: 8px;
    }

    .xp-dialog-text p {
      font-size: 13px;
      color: #222222;
      line-height: 1.5;
    }

    .xp-dialog-footer {
      padding: 12px 28px 20px;
      display: flex;
      justify-content: flex-end;
    }

    .xp-dialog-ok-btn {
      background: #ece9d8;
      border: 2px outset #ffffff;
      border-right-color: #404040;
      border-bottom-color: #404040;
      padding: 8px 32px;
      font-size: 13px;
      font-weight: 800;
      color: #000000;
      outline: 1px solid #000000;
      cursor: pointer;
    }

    /* Windows XP Mouse Pointer */
    #mouseCursor {
      position: absolute;
      top: 0;
      left: 0;
      width: 32px;
      height: 32px;
      z-index: 100;
      pointer-events: none;
      filter: drop-shadow(3px 4px 6px rgba(0,0,0,0.8));
    }

    .click-ripple {
      position: absolute;
      width: 40px;
      height: 40px;
      border: 2.5px solid #0055ea;
      border-radius: 50%;
      z-index: 99;
      transform: translate(-50%, -50%) scale(0.2);
      opacity: 0;
    }
  </style>
</head>
<body>
  <!-- HyperFrames Standalone Composition Root -->
  <div data-hf-id="hf-qj7h" id="root" data-composition-id="stock-order-swap" data-start="0" data-width="1920" data-height="1080" data-duration="10">
    <!-- Background Frame (Pure Pitch-Black) -->
    <div data-hf-id="hf-2xc0" id="bg">
      
      <!-- Glitch RGB Signal Layers -->
      <div data-hf-id="hf-k7ae" class="crt-glitch-layer red" id="glitchRed"></div>
      <div data-hf-id="hf-70sa" class="crt-glitch-layer cyan" id="glitchCyan"></div>

      <!-- CRT Scanlines -->
      <div data-hf-id="hf-hh4q" class="crt-scanlines"></div>

      <!-- VHS 2005 Timestamp -->
      <div data-hf-id="hf-rzm6" class="vhs-timestamp">REC ● DEC 08 2005 - 09:27:04 JST</div>

      <!-- Main Stage Clip -->
      

    </div>
  </div>

  <!-- GSAP Animation Master Timeline -->
  <script>
    window.__timelines = window.__timelines || {};

    const tl = gsap.timeline({ paused: true });

    // DOM References
    const minimalStage = "#minimalStage";
    const boxQty = "#boxQty";
    const boxPrice = "#boxPrice";
    const valQty = document.getElementById("valQty");
    const valPrice = document.getElementById("valPrice");
    const caretQty = "#caretQty";
    const caretPrice = "#caretPrice";
    const swapBtn = "#swapBtn";
    const mouseCursor = "#mouseCursor";
    const clickRipple = "#clickRipple";
    const btnConfirm = "#btnConfirm";
    const btnOutlineFlash = "#btnOutlineFlash";
    const modalBackdrop = "#modalBackdrop";
    const dialogBox = "#dialogBox";
    const dialogOkBtn = "#dialogOkBtn";
    const glitchRed = "#glitchRed";
    const glitchCyan = "#glitchCyan";

    // Initial Setup
    gsap.set(minimalStage, { scale: 0.95, opacity: 0 });
    gsap.set([caretQty, caretPrice], { opacity: 0 });
    gsap.set(btnOutlineFlash, { opacity: 0 });
    gsap.set(mouseCursor, { x: 1450, y: 920, opacity: 0 });
    gsap.set(clickRipple, { opacity: 0 });
    gsap.set(modalBackdrop, { opacity: 0 });
    gsap.set(dialogBox, { opacity: 0, scale: 0.9 });

    function triggerClick(x, y, color = "#0055ea") {
      gsap.set(clickRipple, { x, y, borderColor: color, opacity: 1, scale: 0.2 });
      gsap.to(clickRipple, { scale: 1.4, opacity: 0, duration: 0.35, ease: "power2.out" });
    }

    // 1. Entrance (0.0s - 0.8s)
    tl.to(minimalStage, { scale: 1, opacity: 1, duration: 0.7, ease: "power2.out" }, 0.2);
    tl.to(mouseCursor, { opacity: 1, duration: 0.3 }, 0.4);

    // 2. Cursor Moves to Quantity Counter & Clicks (0.8s - 1.3s)
    // Target Quantity Box ~ (1300, 420)
    tl.to(mouseCursor, { x: 1300, y: 420, duration: 0.6, ease: "power2.inOut" }, 0.7);
    tl.add(() => triggerClick(1300, 420), 1.3);

    tl.to(boxQty, { className: "counter-box active", duration: 0.1 }, 1.3);
    tl.to(caretQty, { opacity: 1, duration: 0.1 }, 1.3);

    // Typing 610,000 (1.4s - 2.2s)
    const qtyText = ["", "6", "61", "610", "610,", "610,0", "610,00", "610,000"];
    qtyText.forEach((txt, i) => {
      tl.add(() => { valQty.textContent = txt; }, 1.4 + (i * 0.1));
    });

    // 3. Cursor Moves to Limit Price Counter & Clicks (2.3s - 2.8s)
    tl.to(boxQty, { className: "counter-box", duration: 0.1 }, 2.3);
    tl.to(caretQty, { opacity: 0, duration: 0.1 }, 2.3);

    // Target Price Box ~ (1300, 560)
    tl.to(mouseCursor, { x: 1300, y: 560, duration: 0.5, ease: "power2.inOut" }, 2.3);
    tl.add(() => triggerClick(1300, 560), 2.8);

    tl.to(boxPrice, { className: "counter-box active", duration: 0.1 }, 2.8);
    tl.to(caretPrice, { opacity: 1, duration: 0.1 }, 2.8);

    // Typing ¥1 (2.9s - 3.2s)
    const priceText = ["", "¥", "¥1"];
    priceText.forEach((txt, i) => {
      tl.add(() => { valPrice.textContent = txt; }, 2.9 + (i * 0.12));
    });

    // 4. SNAP-ZOOM CAMERA & CURSOR MOVES TO SWAP BUTTON (3.4s - 4.2s)
    // Snap zoom into giant counters
    tl.to(minimalStage, { scale: 1.35, y: 60, duration: 0.5, ease: "power2.inOut" }, 3.4);

    // Cursor moves to Swap Button ~ (1350, 550)
    tl.to(mouseCursor, { x: 1330, y: 540, duration: 0.5, ease: "power2.out" }, 3.4);
    tl.to(mouseCursor, { x: 1352, y: 552, duration: 0.2, ease: "sine.inOut" }, 3.9);
    tl.to(mouseCursor, { x: 1350, y: 550, duration: 0.1, ease: "sine.inOut" }, 4.1);

    // CLICK SWAP BUTTON (4.2s)
    tl.add(() => triggerClick(1350, 550, "#cc0000"), 4.2);
    tl.to(swapBtn, { borderStyle: "inset", duration: 0.1, yoyo: true, repeat: 1 }, 4.2);

    // 5. DRAMATIC 64PX COUNTER SWAP & WINDOWS XP ERROR POPUP (4.3s - 5.6s)
    // CRT Glitch flash
    tl.to(glitchRed, { opacity: 0.9, duration: 0.08, yoyo: true, repeat: 2 }, 4.3);
    tl.to(glitchCyan, { opacity: 0.9, duration: 0.08, yoyo: true, repeat: 2 }, 4.3);

    tl.to(boxQty, { className: "counter-box swapped", duration: 0.1 }, 4.3);
    tl.to(boxPrice, { className: "counter-box swapped", duration: 0.1 }, 4.3);

    // Physical numbers position swap animation
    tl.to("#valQty", { y: 140, color: "#ff0033", duration: 0.4, ease: "back.inOut(1.4)" }, 4.3);
    tl.to("#valPrice", { y: -140, color: "#ff0033", duration: 0.4, ease: "back.inOut(1.4)" }, 4.3);

    // Commit swapped text
    tl.add(() => {
      valQty.textContent = "1";
      valPrice.textContent = "¥610,000";
      gsap.set(["#valQty", "#valPrice"], { y: 0 });
    }, 4.7);

    // Show Windows XP Critical Error Modal
    tl.to(modalBackdrop, { opacity: 1, duration: 0.2 }, 4.7);
    tl.to(dialogBox, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(1.4)" }, 4.7);

    // Cursor moves to click [ OK ] on Error Box ~ (1160, 580)
    tl.to(mouseCursor, { x: 1160, y: 580, duration: 0.4, ease: "power2.inOut" }, 4.9);
    tl.add(() => triggerClick(1160, 580, "#000000"), 5.3);
    tl.to(dialogOkBtn, { borderStyle: "inset", duration: 0.1, yoyo: true, repeat: 1 }, 5.3);

    // Close Error Dialog
    tl.to(modalBackdrop, { opacity: 0, duration: 0.2 }, 5.5);
    tl.to(dialogBox, { opacity: 0, scale: 0.9, duration: 0.2 }, 5.5);

    // 6. CAMERA ZOOMS BACK OUT & CURSOR MOVES TO CONFIRM BUTTON (5.7s - 6.5s)
    tl.to(minimalStage, { scale: 1, y: 0, duration: 0.6, ease: "power2.inOut" }, 5.7);

    // Target Confirm button center ~ (960, 680)
    tl.to(mouseCursor, { x: 960, y: 680, duration: 0.7, ease: "power2.inOut" }, 5.8);
    tl.add(() => triggerClick(960, 680, "#00ff44"), 6.5);
    tl.to(btnConfirm, { borderStyle: "inset", duration: 0.1, yoyo: true, repeat: 1 }, 6.5);

    // 7. RETRO SOLID OUTLINE FLASHING (6.6s - 10.0s)
    tl.to(btnOutlineFlash, { opacity: 1, duration: 0.2, yoyo: true, repeat: 7, ease: "steps(1)" }, 6.6);

    // Register Master Timeline
    window.__timelines["stock-order-swap"] = tl;
  </script>
</body>
</html>
